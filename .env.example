# Copy to .env.local for local experiments. Production values live in
# Vercel → Settings → Environment Variables. Do not commit real secrets.

# Public site URL used in emails and canonical fallbacks.
SITE_BASE_URL=https://www.columbuswaterfiltration.com

# Click-to-call number. Overrides the phone in src/lib/site.ts at runtime
# via /api/site-config. Use the renter's tracking number.
# TRACKING_NUMBER=+16145550100

# ── Lead email (Resend) ────────────────────────────────────────────────────
# API key: https://resend.com/api-keys
# The domain localwebbuilders.io is already verified in Resend.
RESEND_API_KEY=
# Optional. Defaults to: Columbus Water Filtration <leads@localwebbuilders.io>
RESEND_FROM=Columbus Water Filtration <leads@localwebbuilders.io>
# Comma-separated. Defaults to devyn@localwebbuilders.io.
# Add the renter later without removing the owner.
LEAD_NOTIFY_EMAILS=devyn@localwebbuilders.io
# Also receives a copy when set, and may sign in to /dashboard.
OWNER_EMAIL=devyn@localwebbuilders.io
# Future renter. Receives lead email and may sign in. Leave blank for now.
BUYER_EMAIL=

# ── Dashboard sign-in ──────────────────────────────────────────────────────
# Long random string. Signs magic links. Example: openssl rand -base64 32
BUYER_SECRET=
# Change this value to revoke every outstanding dashboard link.
BUYER_ACCESS_NONCE=v1
# Extra dashboard emails, comma-separated. devyn@localwebbuilders.io is always allowed.
# DASHBOARD_EMAILS=

# Bearer token for POST /api/admin/resolve-dispute
ADMIN_TOKEN=

# Shared secret for POST /api/phone-lead (call tracking later).
# Header: x-webhook-secret
CALL_WEBHOOK_SECRET=

# ── Ledger ─────────────────────────────────────────────────────────────────
# auto (default): Redis when Upstash env is present, otherwise a local JSON file.
# file | redis | ghl
LEDGER_DRIVER=auto
# Local file override (development). Ignored on a good Redis setup.
# LEAD_DATA_FILE=.data/leads.json

# Upstash Redis (Vercel Marketplace → Upstash). Required for durable leads
# on Vercel. The file driver does not persist across serverless instances.
# https://vercel.com/docs/storage/upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional GoHighLevel adapter. Only used when LEDGER_DRIVER=ghl.
# Create a sub-account, a private integration token, and a pipeline.
# GHL_PIT=
# GHL_LOCATION_ID=
# GHL_PIPELINE_ID=
# GHL_STAGE_NEW=
# GHL_STAGE_CONTACTED=
# GHL_STAGE_BOOKED=
# GHL_STAGE_WON=
# GHL_STAGE_LOST=

# Repeat contact inside this many days is delivered but not billable.
LEAD_DEDUPE_DAYS=30

# Dashboard billing figures. Leave unset to hide dollars (nothing is invented).
# LEAD_PRICING_MODE=per_lead
# LEAD_PRICE=
# LEAD_FLAT_MONTHLY=
# LEAD_MONTHLY_INCLUDED=
